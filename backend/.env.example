# Copy this file to backend/.env and fill in real values.
# Never commit backend/.env — it is git-ignored.

# --- Frontend origins allowed to call the API (comma-separated) ---
CORS_ORIGINS=http://localhost:5173,http://localhost:3000
# Where the browser returns after the Zerodha login
FRONTEND_URL=http://localhost:5173

# --- Database (PostgreSQL) ---
# Format: postgresql+asyncpg://USER:PASSWORD@HOST:PORT/DBNAME
# Supabase: use the SESSION pooler (port 5432; the transaction pooler on 6543 breaks asyncpg):
#   postgresql+asyncpg://postgres.PROJECT_REF:DB_PASSWORD@aws-0-REGION.pooler.supabase.com:5432/postgres
# Local PostgreSQL: postgresql+asyncpg://postgres:PASSWORD@localhost:5432/investment_copilot
# Special characters in the password must be URL-encoded (@ -> %40, : -> %3A, / -> %2F, # -> %23).
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/investment_copilot

# --- Supabase project (optional; the backend talks to the database through DATABASE_URL) ---
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=

# --- API keys: one key in X_API_KEY and/or several, comma-separated, in X_API_KEYS ---
# Keys are tried IN ORDER. A key that is rate-limited, out of quota or invalid is skipped
# for a while and the next key is used (backend/app/services/key_pool.py).

# --- LLM provider: "gemini" or "openai" ---
# If every key of LLM_PROVIDER fails, the other provider's keys are tried
# (turn off with LLM_CROSS_PROVIDER_FALLBACK=false).
LLM_PROVIDER=gemini
GEMINI_API_KEY=
GEMINI_API_KEYS=
OPENAI_API_KEY=
OPENAI_API_KEYS=
# Model names change over time. Comma-separated = fallback models, tried in order when a
# model is overloaded (503) or times out.
GEMINI_MODEL=gemini-3.5-flash,gemini-3.8-flash,gemini-3.1-flash-lite
# Gemini 3 thinking effort (minimal/low/medium/high); thinking tokens are added on top of max_tokens.
GEMINI_THINKING_LEVEL=low
OPENAI_MODEL=gpt-4o-mini

# --- News API (https://www.marketaux.com, free tier ~100 req/day per key) ---
MARKETAUX_API_KEY=
MARKETAUX_API_KEYS=

# --- Technical indicators (https://www.alphavantage.co, free tier 25 req/day per key) ---
ALPHAVANTAGE_API_KEY=
ALPHAVANTAGE_API_KEYS=

# --- Zerodha Kite Connect (https://developers.kite.trade, personal tier) ---
# In the Kite app settings set Redirect URL = http://127.0.0.1:8000/portfolio/zerodha/callback
ZERODHA_API_KEY=
ZERODHA_API_SECRET=

# --- Vector store (local ChromaDB folder) + local embedding model ---
# Defaults: backend/chroma_data (git-ignored), collection "financial_news".
# CHROMA_PERSIST_DIR=
CHROMA_COLLECTION=financial_news
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
# Load the embedding model in the background at startup (cold load ~40-60 s). Set false
# to skip (e.g. when only working on unrelated endpoints).
EMBEDDING_WARMUP=true

# --- Background jobs (news every 10 min, market data every 30 min) ---
# Set SCHEDULER_ENABLED=false to stop all API polling (e.g. while editing code).
# Run uvicorn with ONE worker, otherwise every job runs once per worker.
SCHEDULER_ENABLED=true
NEWS_INGEST_INTERVAL_MINUTES=10
MARKET_UPDATE_INTERVAL_MINUTES=30
SCHEDULER_FIRST_RUN_DELAY_SECONDS=60

# --- JWT auth ---
# Generate one with: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET_KEY=
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7
